NODE_ENV=development
HOST=127.0.0.1
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:1420,http://tauri.localhost
SWAGGER_ENABLED=true
LOG_LEVEL=log
DATABASE_URL=postgresql://pharmacy:pharmacy_dev_password@localhost:5433/pharmacy_records?schema=public
DIRECT_URL=postgresql://pharmacy:pharmacy_dev_password@localhost:5433/pharmacy_records?schema=public
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=3600
JWT_ISSUER=pharmacy-records-api
JWT_AUDIENCE=pharmacy-records-desktop
UPLOAD_DIR=storage/medical-records
# Nơi lưu ảnh hồ sơ: local | supabase | r2.
# Render có ổ đĩa tạm thời → production nên dùng r2 (hoặc supabase) để ảnh không mất khi redeploy.
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=medical-records
# Cloudflare R2 (bucket private). Cần R2_ACCOUNT_ID hoặc R2_ENDPOINT.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=medical-records
MAX_IMAGE_UPLOAD_BYTES=10485760

# Tài khoản quản trị khởi tạo bằng `pnpm db:seed` (chỉ dùng mật khẩu mẫu khi phát triển)
ADMIN_FULL_NAME=Quản trị viên
ADMIN_EMAIL=admin@pharmacy.local
ADMIN_PASSWORD=ChangeMe-Dev-Only-123!
