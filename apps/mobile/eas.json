{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://pharmacy-record.onrender.com/api",
        "EXPO_PUBLIC_USE_RN_FETCH": "1"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://pharmacy-record.onrender.com/api",
        "EXPO_PUBLIC_USE_RN_FETCH": "1"
      }
    }
  }
}
