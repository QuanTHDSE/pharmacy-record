# Backend mà app mobile gọi tới (cùng server với desktop).
# Muốn dùng API chạy trên máy mình: tạo .env.local (đã gitignore) với
# EXPO_PUBLIC_API_BASE_URL=http://<IP-LAN-của-máy>:3000/api
EXPO_PUBLIC_API_BASE_URL=https://pharmacy-record.onrender.com/api

# Expo SDK 58 thay fetch mặc định bằng expo/fetch, vốn KHÔNG gửi được file dạng
# FormData { uri, name, type } → upload ảnh hồ sơ bị lỗi. Giữ fetch của React Native.
EXPO_PUBLIC_USE_RN_FETCH=1
